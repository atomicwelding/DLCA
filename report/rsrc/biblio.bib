@article{rottereau_monte_2004,
	title = {Monte Carlo simulation of particle aggregation and gelation: I. Growth, structure and size distribution of the clusters},
	volume = {15},
	rights = {http://www.springer.com/tdm},
	issn = {1292-8941, 1292-895X},
	url = {http://link.springer.com/10.1140/epje/i2004-10044-x},
	doi = {10.1140/epje/i2004-10044-x},
	shorttitle = {Monte Carlo simulation of particle aggregation and gelation},
	abstract = {Lattice and oﬀ-lattice Monte Carlo simulations of diﬀusion-limited cluster aggregation and gelation were done over a broad range of concentrations. The large-scale structure and the size distribution of the clusters are characterized by a crossover at a characteristic size (mc). For m {\textless} mc, they are the same as obtained in a dilute {DLCA} process and for m ¿ mc they are the same as obtained in a static percolation process. mc is determined by the overlap of the clusters and decreases with increasing particle concentration. The growth rate of large clusters is a universal function of time reduced by the gel time. The large-scale structural and temporal properties are the same for lattice and oﬀ-lattice simulations. The average degree of connectivity per particle in the gels formed in oﬀ-lattice simulations is independent of the concentration, but its distribution depends on the concentration.},
	pages = {133--140},
	number = {2},
	journaltitle = {Eur. Phys. J. E},
	author = {Rottereau, M. and Gimel, J. C. and Nicolai, T. and Durand, D.},
	urldate = {2025-02-27},
	date = {2004-10},
	langid = {english},
	file = {PDF:/Users/weld/Zotero/storage/SL5JKTVH/Rottereau et al. - 2004 - Monte Carlo simulation of particle aggregation and gelation I. Growth, structure and size distribut.pdf:application/pdf},
}

@article{rottereau_monte_2004-1,
	title = {Monte Carlo simulation of particle aggregation and gelation: {II}. Pair correlation function and structure factor},
	volume = {15},
	rights = {http://www.springer.com/tdm},
	issn = {1292-8941, 1292-895X},
	url = {http://link.springer.com/10.1140/epje/i2004-10045-9},
	doi = {10.1140/epje/i2004-10045-9},
	shorttitle = {Monte Carlo simulation of particle aggregation and gelation},
	abstract = {Diﬀusion-limited cluster aggregation and gelation are studied using lattice and oﬀ-lattice Monte Carlo simulations. The pair correlation function g(r) and the structure factor S(q) of the particle gels were investigated as a function of the volume fraction (0.5–49\%) and time. At volume fractions below 5\%, the gel structure is fractal on small length scales with df = 1.8. g(r) shows a weak minimum at the correlation length (ξ), before reaching the average concentration at large length scales. The cut-oﬀ function of g(r) varies during the aggregation process, but at a given t/tg, where tg is the gel time, it is a universal function of r/ξ. At high volume fractions, the structure is dominated by excluded-volume interactions, while at low volume fractions, it is determined by the connectivity.},
	pages = {141--148},
	number = {2},
	journaltitle = {Eur. Phys. J. E},
	author = {Rottereau, M. and Gimel, J. C. and Nicolai, T. and Durand, D.},
	urldate = {2025-02-27},
	date = {2004-10},
	langid = {english},
	file = {PDF:/Users/weld/Zotero/storage/JNNE8TLT/Rottereau et al. - 2004 - Monte Carlo simulation of particle aggregation and gelation II. Pair correlation function and struc.pdf:application/pdf},
}

@article{wang_kinetic_2017,
	title = {Kinetic Monte Carlo Simulation for Quantification of the Gel Point of Polymer Networks},
	volume = {6},
	issn = {2161-1653, 2161-1653},
	url = {https://pubs.acs.org/doi/10.1021/acsmacrolett.7b00586},
	doi = {10.1021/acsmacrolett.7b00586},
	abstract = {Accurate prediction of the gel point for real polymer networks is a long-standing challenge in polymer chemistry and physics that is extremely important for applications of gels and elastomers. Here, kinetic Monte Carlo simulation is applied to simultaneously describe network topology and growth kinetics. By accounting for topological defects in the polymer networks, the simulation can quantitatively predict experimental gel point measurements without any ﬁtting parameters. Gel point suppression becomes more severe as the primary loop fraction in the networks increases. A topological homomorphism theory mapping defects onto eﬀective junctions is developed to qualitatively explain the origins of this eﬀect, which accurately captures the gel point suppression in the low loop limit where cooperative eﬀects between topological defects are small.},
	pages = {1414--1419},
	number = {12},
	journaltitle = {{ACS} Macro Lett.},
	author = {Wang, Rui and Lin, Tzyy-Shyang and Johnson, Jeremiah A. and Olsen, Bradley D.},
	urldate = {2025-02-27},
	date = {2017-12-19},
	langid = {english},
	file = {PDF:/Users/weld/Zotero/storage/Q6TE7YQE/Wang et al. - 2017 - Kinetic Monte Carlo Simulation for Quantification of the Gel Point of Polymer Networks.pdf:application/pdf},
}

