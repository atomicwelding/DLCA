@article{lepere_k-dependence_2000,
	title = {\textit{K}-dependence of broadening coefficients for {CH}3F–N2 and for other systems involving a symmetric top molecule},
	volume = {517-518},
	issn = {0022-2860},
	url = {https://www.sciencedirect.com/science/article/pii/S0022286099002719},
	doi = {10.1016/S0022-2860(99)00271-9},
	abstract = {The variations of N2-broadening coefficients of {CH}3F with the rotational quantum number K have been studied in the ν2 and ν5 bands, using a diode-laser spectrometer. Four different line families with same J values ranging from 3 to 17, and same ΔJ and ΔK values have been recorded in the spectral range 1478–1573cm−1. The collisional halfwidths are obtained by fitting Voigt and Rautian profiles to the measured shapes of the lines. A semi-classical calculation of the N2 broadening has provided results that are in overall agreement with the experimental data. The general trend for the broadening coefficients belonging to the same J transition is to decrease with increasing K; this decrease is more significant at low J than at high J values. A similar K behavior has been observed and predicted for other binary systems: {CH}3F self-perturbed or perturbed by O2, He, Ar; {CH}3D self-perturbed or perturbed by N2, O2. A different K behavior is observed for the broadening coefficients of a symmetric top molecule having an inversion motion such as {NH}3.},
	pages = {493--502},
	journaltitle = {Journal of Molecular Structure},
	author = {Lepère, M. and Blanquet, G. and Walrand, J. and Bouanich, J. -P.},
	urldate = {2025-04-16},
	date = {2000-02-16},
	keywords = {-dependence, Broadening coefficients, {CHF}–N interactions, Symmetric top molecule},
	file = {ScienceDirect Snapshot:/Users/weld/Zotero/storage/TCPAZN2T/S0022286099002719.html:text/html},
}

@article{lerot_n2-_2006,
	title = {N2- and O2-broadening coefficients in the \textit{ν}2 and \textit{ν}5 bands of 12CH3F at 183 and 298   K},
	volume = {235},
	issn = {0022-2852},
	url = {https://www.sciencedirect.com/science/article/pii/S0022285205002559},
	doi = {10.1016/j.jms.2005.11.004},
	abstract = {The N2- and O2-broadening coefficients of 33 rovibrational lines in the ν2 and ν5 bands of 12CH3F were measured at 183K using a diode-laser spectrometer. The measurement of these coefficients was also realized at room temperature for 10 of these lines to determine their temperature dependence. The line parameters were obtained by fitting to the experimental profile the Voigt lineshape, and the Rautian and Galatry models taking into account the collisional narrowing. Calculations of the pressure-broadening coefficients were also performed for the same temperatures from a semiclassical model involving electrostatic, induction and dispersion interactions in the intermolecular potential. The calculated values reproduce well the experimental data for both temperatures and both perturbers and the theoretical temperature dependence of the broadening coefficients is in satisfactory agreement with that derived from the measurements.},
	pages = {196--205},
	number = {2},
	journaltitle = {Journal of Molecular Spectroscopy},
	author = {Lerot, Christophe and Blanquet, Ghislain and Bouanich, Jean-Pierre and Walrand, Jacques and Lepère, Muriel},
	urldate = {2025-04-16},
